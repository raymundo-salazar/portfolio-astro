---
import Button from "@/components/atoms/Button/index"
import Header from "@/sections/Header/index.astro"
import "@/styles/global.css"
import { ArrowRight } from "@lucide/astro"
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Brief personalizado - Raymundo Salazar</title>
		<meta
			name="description"
			content="Cada proyecto tiene su propio espacio y se accede con un enlace privado."
		/>
		<meta name="robots" content="noindex, nofollow" />
	</head>
	<body class="bg-neutral-950 text-white antialiased">
		<main class="relative min-h-screen overflow-hidden bg-[radial-gradient(circle_at_top,_rgba(59,130,246,0.16),_transparent_34%),linear-gradient(135deg,_#09090b_0%,_#111827_52%,_#09090b_100%)]">
			<div class="absolute left-[-8rem] top-[-6rem] h-72 w-72 rounded-full bg-blue-500/15 blur-3xl"></div>
			<div class="absolute right-[-6rem] top-24 h-80 w-80 rounded-full bg-cyan-500/12 blur-3xl"></div>
			<div class="absolute bottom-[-5rem] left-1/3 h-64 w-64 rounded-full bg-blue-900/25 blur-3xl"></div>

			<Header minimal />

			<section class="relative z-10 flex min-h-screen items-center justify-center px-4 pb-16 pt-28 sm:px-6 lg:px-8">
				<div class="w-full max-w-5xl text-center">
					<p class="animate-fade-in-up text-xs font-semibold uppercase tracking-[0.38em] text-blue-300/90">
						BRIEF DE PROYECTO
					</p>
					<h1 class="mt-6 text-4xl font-semibold tracking-tight text-white sm:text-6xl lg:text-7xl">
						Cada proyecto tiene su propio espacio
					</h1>
					<p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-white/80 sm:text-xl">
						Cada proyecto cuenta con un espacio preparado especialmente para él.
					</p>
					<p class="mx-auto mt-4 max-w-3xl text-sm leading-7 text-white/60 sm:text-base">
						Para acceder al tuyo, utiliza el enlace que te compartimos. Si lo perdiste o
						necesitas que te lo enviemos nuevamente, escríbenos.
					</p>

					<div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-5">
						<Button
							link
							href="/"
							variant="primary"
							floating
							rounded
							className="w-fit px-6 py-3.5 sm:px-8 sm:py-4"
						>
							Volver al portafolio
						</Button>
						<Button
							link
							href="/#contact"
							variant="secondary"
							outline
							rounded
							className="w-fit px-5 py-3 text-sm sm:px-6"
						>
							¿Necesitas tu enlace? Contáctanos
							<ArrowRight class="h-4 w-4" />
						</Button>
					</div>
				</div>
			</section>
		</main>
	</body>
</html>
